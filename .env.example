# Example environment variables for local development
# Copy to `.env` and adjust values as needed

# For SQLite (default)
DATABASE_URL="file:./dev.db"

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Optional: public URL used when generating shareable payment links.
# On Vercel, set this to your production domain, for example:
# NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Admin (use base64-encoded JSON service account)
# Example: FIREBASE_SERVICE_ACCOUNT_KEY="$(cat serviceAccount.json | base64)"
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
# Prisma Database URL
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_super_secret_key_here"

# To switch to PostgreSQL, comment out the SQLite line above and use this format:
# DATABASE_URL="postgresql://user:password@localhost:5432/upipay?schema=public"
# Also change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
