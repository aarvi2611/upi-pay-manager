generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  role      String   @default("ADMIN") // ADMIN, STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id        String   @id @default(cuid())
  name      String
  upiId     String
  logoUrl   String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id             String    @id @default(cuid())
  orderId        String    @unique
  customerName   String
  customerPhone  String?
  amount         Float
  purpose        String?
  status         String    @default("PENDING") // PENDING, PAID, FAILED, CANCELLED
  utrNumber      String?   @unique
  paymentDate    DateTime?
  proofUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
